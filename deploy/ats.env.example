# /etc/ats/ats.env — переменные окружения сервиса ATS (права 640, владелец root:ats).
# systemd читает её через EnvironmentFile, deploy/update.sh — через `set -a; . file`.
# Секреты можно хранить здесь (тогда в настройках UI указывайте ИМЯ переменной в поле *_env)
# или прямо в интерфейсе (тогда они лежат в SQLite и маскируются в UI).

# --- расположение и порт ---
ATS_DATA_DIR=/var/lib/ats
ATS_PORT=9124
ATS_SERVICE=ats

# --- телефония: МегаФон ВАТС ---
# ATS_MEGAFON_API_KEY=
# ATS_MEGAFON_CRM_TOKEN=

# --- телефония: агрегатор Мультиком ---
# ATS_MULTICOM_API_KEY=
# ATS_MULTICOM_WEBHOOK_TOKEN=        # входной секрет для /api/v2/webhooks/multicom

# --- телефония: Asterisk + SIP-транк оператора (Мультиком и т.п.) ---
# Host/port/trunk/форматы номера задаются в интерфейсе (Настройки → Asterisk AMI Manager);
# AMI-пароль можно хранить здесь и указать имя переменной в настройках.
# ATS_AMI_HOST=127.0.0.1
# ATS_AMI_USER=ats
# ATS_AMI_SECRET=

# --- записи разговоров: подписанные ссылки (amoCRM) и загрузчик с Asterisk ---
# ATS_RECORDS_LINK_TOKEN=            # если пусто — сгенерируется и сохранится в настройки
# ATS_URL=http://127.0.0.1:9124       # для deploy/asterisk/attach_recordings.py (cron)
# ATS_LOGIN=
# ATS_PASSWORD=
# ATS_TOKEN=                          # готовый токен — тогда вход не выполняется
# ATS_WATCH_DIR=/var/spool/asterisk/monitor/ats

# --- amoCRM (приватная интеграция, вкладка «Ключи») ---
# ATS_AMOCRM_TOKEN=
# ATS_AMOCRM_CLIENT_SECRET=
# ATS_AMOCRM_REFRESH_TOKEN=
# ATS_AMOCRM_WEBHOOK_TOKEN=

# --- ИИ-агент L2 (OpenAI-совместимый) ---
# ATS_LLM_KEY=
# ATS_LLM_BASE_URL=https://…/v1

# --- прочее ---
# ATS_ADMIN_PASSWORD=               # только для первичной инициализации
# ATS_FAST=1                        # ускоренные тайминги (стенде, НЕ в проде)
# ATS_ALLOW_SIM_FALLBACK=1          # разрешить откат на симулятор (только стенд!)
# ATS_DEV_SEED=1                    # демо-данные и тестовые номера (только стенд!)
