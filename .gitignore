# Виртуальное окружение
venv/
env/
ENV/
.venv/

# Файлы Python
__pycache__/
*.py[cod]
*.class
*.so
.Python
*.pyc

# Файлы IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Системные файлы
Thumbs.db
.DS_Store

# Логи и временные файлы
*.log
*.tmp
*.bak

# Frontend Node modules
frontend/node_modules/
frontend/dist/

# Служебное состояние обновления на сервере (deploy/update.sh)
.deploy-last
.deploy-stash-note

# Runtime-данные боевого сервера, если АТС запущена «в репозитории»
# (на проде правильнее ATS_DATA_DIR=/var/lib/ats — см. docs/DEPLOY.md §3.4).
# P0-фикс (2026-10-21): весь data_v2/ — локальное состояние (БД, креды первого
# входа, логи, записи) и никогда не должен попадать в git. Исторически
# data_v2/ats.db и initial_credentials.txt были в индексе — убраны (см.
# docs/SECURITY_CLEANUP.md §3). Защита от возврата — tests/test_no_runtime_secrets.py.
data_v2/
# база и первичные креды — где угодно в дереве, не только в data_v2/
*.db
initial_credentials.txt
*.db-wal
*.db-shm
# экспорт/импорт/записи: только .keep-маркеры каталогов
exports/*
!exports/.keep
imports/*
!imports/.keep
records/*
!records/.keep
node_modules/

# venv, развёрнутый прямо в корень репозитория (кто-то выполнил `python3 -m venv .`).
# Смысл не в чистоте git status, а в том, чтобы тысячи файлов site-packages никогда
# не попадали ни в stash, ни в commit: deploy/update.sh работает без `stash -u`.
/bin/
/lib/
/lib64
/include/
/share/
/pyvenv.cfg
